---
import type { Post } from '../lib/posts';
import { postPath } from '../lib/posts';
import { slugify, withBase } from '../lib/url';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  /** Position within the current list — rendered as a big "01" beside the entry. */
  index: number;
}

const { post, index } = Astro.props;
const { title, description, date, category, tags } = post.data;
const href = withBase(postPath(post));
---

<li class="post-row">
  <span class="post-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>

  <div class="post-row-body">
    <p class="meta">
      <a class="pill pill-accent" href={withBase(`/category/${slugify(category)}/`)}>{category}</a>
      <FormattedDate date={date} />
    </p>

    <h3><a href={href}>{title}</a></h3>
    <p class="card-excerpt">{description}</p>

    {
      tags.length > 0 && (
        <ul class="tag-list">
          {tags.map((tag) => (
            <li>
              <a class="pill" href={withBase(`/tag/${slugify(tag)}/`)}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="card-footer">
      <a class="read-more" href={href}>
        Read more<span class="visually-hidden"> about {title}</span>
      </a>
    </p>
  </div>
</li>
